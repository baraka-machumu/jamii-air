# Jamii Air backend — local environment.
# Copy to backend/.env (git-ignored) and replace every `change-me`.
# Read by `docker compose` (backend/docker-compose.yml) and by the API, worker and Prisma.
# Passwords are used inside URLs below: keep them URL-safe (letters and digits).

# ── PostgreSQL 18 ──────────────────────────────────────────────
POSTGRES_PORT=5432
POSTGRES_DB=jamii_air
# Superuser `postgres`: local administration only, never used by the app.
POSTGRES_SUPERUSER_PASSWORD=change-me
# Migration role: owns the schema, runs `prisma migrate deploy` (SR-02).
JAMII_OWNER_PASSWORD=change-me
# Runtime role: API and worker; no table write privileges (SR-01).
JAMII_APP_PASSWORD=change-me
# Connection strings — must repeat the port, database and passwords above.
DATABASE_URL=postgresql://jamii_app:change-me@localhost:5432/jamii_air
MIGRATION_DATABASE_URL=postgresql://jamii_owner:change-me@localhost:5432/jamii_air

# ── Redis 7 (BullMQ, rate limits) ──────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379

# ── MinIO (S3-compatible object storage) ───────────────────────
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=jamii-local
MINIO_ROOT_PASSWORD=change-me
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jamii-air-media-local
# Local only: the app uses the MinIO root credentials.
S3_ACCESS_KEY_ID=jamii-local
S3_SECRET_ACCESS_KEY=change-me

# ── Mailpit (local SMTP catcher; web UI on MAILPIT_UI_PORT) ────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
