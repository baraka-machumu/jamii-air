# Jamii Air backend — local environment.
# Copy to backend/.env (git-ignored) and replace every `change-me`.
# Read by `docker compose` (backend/docker-compose.yml) and by the API, worker and Prisma.
# Passwords are used inside URLs below: keep them URL-safe (letters and digits).

# ── API ────────────────────────────────────────────────────────
# development | test | uat | production (OpenAPI docs at /api/v1/docs except in production)
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent (default: info in production, else debug)
LOG_LEVEL=debug
# Pilot: registration needs an invite code (BR-AC-02)
REQUIRE_INVITE=true
# Secrets, at least 32 characters each, different from each other (generate: openssl rand -hex 32).
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
AUTH_CODE_SECRET=change-me-change-me-change-me-change-me-too
MAIL_FROM=Jamii Air <no-reply@jamii-air.local>

# ── Share links and app links (TRD SH-01/02) ───────────────────
# Public site serving /p/:id, /u/:username and /.well-known; base of shareUrl. Empty = this API.
PUBLIC_WEB_URL=
# Android App Links: package name and signing-certificate SHA-256 fingerprints (comma-separated).
# Empty until the app identifiers exist (Plan 0.3): assetlinks.json is then served empty.
ANDROID_PACKAGE=
ANDROID_CERT_SHA256=
# iOS Universal Links: <TeamID>.<bundleId> (needs the Apple account, Plan 5.0). App Store page link.
IOS_APP_ID=
IOS_STORE_URL=

# ── PostgreSQL 18 ──────────────────────────────────────────────
POSTGRES_PORT=5432
POSTGRES_DB=jamii_air
# Superuser `postgres`: local administration only, never used by the app.
POSTGRES_SUPERUSER_PASSWORD=change-me
# Migration role: owns the schema, runs `prisma migrate deploy` (SR-02).
JAMII_OWNER_PASSWORD=change-me
# Runtime role: API and worker; no table write privileges (SR-01).
JAMII_APP_PASSWORD=change-me
# Connection strings — must repeat the port, database and passwords above.
DATABASE_URL=postgresql://jamii_app:change-me@localhost:5432/jamii_air
MIGRATION_DATABASE_URL=postgresql://jamii_owner:change-me@localhost:5432/jamii_air

# ── Redis 7 (BullMQ, rate limits) ──────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379

# ── MinIO (S3-compatible object storage) ───────────────────────
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=jamii-local
MINIO_ROOT_PASSWORD=change-me
S3_ENDPOINT=http://localhost:9000
# Host in presigned upload URLs, if phones reach MinIO differently (Android emulator: http://10.0.2.2:9000).
# Empty = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=jamii-air-media-local
# Local only: the app uses the MinIO root credentials.
S3_ACCESS_KEY_ID=jamii-local
S3_SECRET_ACCESS_KEY=change-me
# Base of public media URLs (variants only). Local: MinIO directly; servers: the nginx media cache.
MEDIA_BASE_URL=http://localhost:9000/jamii-air-media-local

# ── Mailpit (local SMTP catcher; web UI on MAILPIT_UI_PORT) ────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
