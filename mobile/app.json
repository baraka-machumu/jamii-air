{
  "expo": {
    "name": "Jamii Air",
    "slug": "jamii-air",
    "owner": "bmachumu",
    "version": "1.0.0",
    "scheme": "jamiiair",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tz.jamiiair.app"
    },
    "android": {
      "package": "tz.jamiiair.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1E1B4B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#C2410C",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Jamii Air uses your photos so you can share them and set your profile photo.",
          "cameraPermission": "Jamii Air uses the camera so you can take photos to share and for your profile."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "6b0cf1ca-db76-4158-9239-778af005e7ba"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/6b0cf1ca-db76-4158-9239-778af005e7ba",
      "fallbackToCacheTimeout": 8000
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
